{
  "name": "localmind",
  "version": "1.0.0",
  "description": "Chat client for open-source models running on Colab",
  "main": "electron/main.js",
  "author": "Joh",
  "scripts": { "start": "electron .", "dist:win": "electron-builder --win" },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/cli": "^6.1.0",
    "@capacitor/core": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.joh.localmind",
    "productName": "LocalMind",
    "files": ["electron/**", "www/**"],
    "directories": { "buildResources": "build" },
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.png" }
  }
}
